{
  "name": "myassistant-backend",
  "version": "0.1.0",
  "description": "MYASSISTANT backend — AI routing, remote config, user services",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node tests/agent.test.js",
    "test:clients": "node scripts/clients-test.js",
    "test:agents": "node scripts/agents-test.js",
    "test:e2e": "node tests/memory.e2e.test.js",
