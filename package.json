    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-prom-bundle": "^8.0.0",
    "express-rate-limit": "^7.4.0",
    "glob": "^13.0.6",
    "google-auth-library": "^10.9.0",
    "helmet": "^7.1.0",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "ws": "^8.21.3"
