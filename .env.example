PORT=3000

# AI provider — GEMINI ONLY. One key powers chat, streaming and voice
# transcription. Get one at aistudio.google.com
GEMINI_API_KEY=
# MODEL LIFECYCLE: Google retires models on a schedule and a retired name
# returns 404 on EVERY call. gemini-2.0-* was shut down 2026-06-01 and the
# gemini-2.5-* family is scheduled for 2026-10-16. Check the current list at
# https://ai.google.dev/gemini-api/docs/models before setting these.
GEMINI_MODEL=gemini-3.6-flash
# Optional: dedicated model for speech-to-text. Transcription is an easy task,
# so a lighter model transcribes faster with no hit to chat quality. Leave
# BLANK to reuse GEMINI_MODEL — that is the safe default. If you set it and
# the model has been retired, the server logs the problem once and falls back
# to GEMINI_MODEL automatically rather than breaking voice input.
GEMINI_STT_MODEL=

# Neural text-to-speech (natural cloud voice, replaces on-device TTS).
# Uses the SAME GEMINI_API_KEY. Voice: one of the 30 Gemini prebuilt voices
# (Kore, Puck, Leda, Aoede, Zephyr, Charon…). Model must be a *-tts variant.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
# How long to wait for speech synthesis before giving up (ms). Kept short:
# the app speaks sentence-by-sentence, so a slow synthesis must fail fast and
# let the phone's on-device voice take over instead of leaving dead air.
GEMINI_TTS_TIMEOUT_MS=15000

# Shared secret the Android app must send as X-App-Key
APP_API_KEY=change-me-to-a-long-random-string

# Google Sign-In (F1) — the *Web* OAuth client ID from Google Cloud Console.
# Must match GOOGLE_WEB_CLIENT_ID in the Android app's build.gradle.kts.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Dev-only fallback: allow X-App-Key auth (never set true in production)
ALLOW_APP_KEY=true   # dev mode — set false before production

# Dev mode: skip all auth. MUST be removed/false in production.
AUTH_DISABLED=true

# Session signing secret — 32+ random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Apple Sign In — your iOS bundle id (audience of Apple's identity token)
APPLE_BUNDLE_ID=com.yourorg.myassistant

# Where user document FILES live (mount a Docker volume here)
DATA_DIR=./data

# Postgres (docker-compose wires this automatically)
#DATABASE_URL=postgres://myassistant:localdev@localhost:5432/myassistant

# --- Admin stats (GET /admin/stats with X-Admin-Key) ---
# 16+ random chars; endpoint is invisible (404) while unset.
ADMIN_KEY=


# --- Agent calls (Hari phones a contact on your behalf, via Plivo) ---
# Feature returns 503 (app falls back to a direct dial) while unset.
# Get credentials + a voice-enabled number at console.plivo.com.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=          # your Plivo number in E.164, e.g. +14155550123
# HTTPS URL Plivo can reach for call webhooks (this server's public address).
PUBLIC_BASE_URL=
# Optional: Plivo <Speak> voice (Amazon Polly). Aditi = Indian English/Hindi.
PLIVO_VOICE=Polly.Aditi
# Optional: max agent calls placed per user per day (default 20).
AGENT_CALL_DAILY_LIMIT=20

# --- Real-time human avatar (Tavus CVI, platform.tavus.io) ---
# Feature is hidden while unset. Free tier ~25 conversation minutes.
# TAVUS_FACE_ID: pick a stock female face in the Tavus library, paste its id.
TAVUS_API_KEY=
TAVUS_FACE_ID=
# Optional: a PAL id (Tavus persona; can carry a custom-LLM layer later)
TAVUS_PAL_ID=
# Guard the free tier: auto-end calls after this many seconds (default 900)
TAVUS_MAX_CALL_SECONDS=900
