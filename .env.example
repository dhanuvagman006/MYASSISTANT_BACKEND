PORT=3000

# AI provider — GEMINI ONLY. One key powers chat, streaming, function
# calling AND voice transcription. Get one at aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Shared secret the Android app must send as X-App-Key
APP_API_KEY=change-me-to-a-long-random-string

# Google Sign-In (F1) — the *Web* OAuth client ID from Google Cloud Console.
# Must match GOOGLE_WEB_CLIENT_ID in the Android app's build.gradle.kts.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Dev-only fallback: allow X-App-Key auth (never set true in production)
ALLOW_APP_KEY=true   # dev mode — set false before production

# Dev mode: skip all auth. MUST be removed/false in production.
AUTH_DISABLED=true

# Session signing secret — 32+ random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Apple Sign In — your iOS bundle id (audience of Apple's identity token)
APPLE_BUNDLE_ID=com.yourorg.myassistant

# Where the SQLite user DB lives (mount a Docker volume here)
DATA_DIR=./data

# Swiggy Builders Club (MCP food ordering) — https://mcp.swiggy.com/builders
# No client id needed (Dynamic Client Registration). Point BASE at staging
# creds once approved; redirect must EXACTLY match what you registered.
# SWIGGY_REDIRECT_URI is optional: when unset it becomes
# <PUBLIC_BASE_URL>/swiggy/callback, falling back to localhost only in dev.
SWIGGY_MCP_BASE=https://mcp.swiggy.com
#SWIGGY_REDIRECT_URI=https://your-server.example.com/swiggy/callback

# --- Agent calls ("call X and ask Y" — AI talks on a real phone call) ---
# Provider: PLIVO (plivo.com) — chosen for India: rents real +91 numbers
# with domestic routing after business KYC (~1 day). Before KYC the same
# account calls India over international routes (dev/testing).
# All four required to enable; POST /agent-call returns 503 otherwise.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=             # your Plivo number, E.164 (+91… once KYC'd)
PUBLIC_BASE_URL=               # https URL of THIS server (Plivo webhooks)
DEFAULT_COUNTRY_CODE=91        # 10-digit local numbers get this prefix
# PLIVO_VALIDATE=false         # DEV ONLY: skip webhook signature checks

# --- Billing (Razorpay payment links: UPI/cards/netbanking) ---
# All three required to enable checkout; /billing/checkout returns 503
# otherwise. Create the webhook in the Razorpay dashboard pointing at
# https://<PUBLIC_BASE_URL>/billing/webhook, event: payment_link.paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Admin stats (GET /admin/stats with X-Admin-Key) ---
# 16+ random chars; endpoint is invisible (404) while unset.
ADMIN_KEY=

# --- D-ID Face Mode + video briefings (docs.d-id.com) ---
# API key from D-ID Studio (Account Settings). Feature is fully hidden
# while unset. PUBLIC_BASE_URL must also be set (D-ID calls us back and
# the app's WebView loads /did/face from it).
DID_API_KEY=
# Shared secret D-ID sends back as x-api-key when calling our custom-LLM
# endpoint (/did/llm/v1/chat/completions). 32+ random chars.
DID_LLM_KEY=
# OPTIONAL — Hari's own face. A public HTTPS portrait/footage URL makes
# the avatar unique to the brand (V3 Instant Avatar or a brand portrait).
# Unset = D-ID stock presenter (fine for development).
DID_PRESENTER_SOURCE_URL=
# Stock presenter used when no custom face is set
DID_PRESENTER_ID=v2_public_Amber@0zSz8kflCN
# Multilingual Indian voice (Microsoft neural) for the avatar + briefings
DID_VOICE_ID=en-IN-AartiIndicNeural

# --- Semantic memory recall (Aug 2026) ---
# Relevance-ranked memory using gemini-embedding-001 (free tier, multilingual).
# Uses the same GEMINI_API_KEY above. Set MEMORY_SEMANTIC=off to disable;
# recall then falls back to the original category-ordered behavior.
MEMORY_SEMANTIC=on
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---------- /assistant (interactive assistant experience) ----------
# OPTIONAL speech-to-text override for the assistant screen — Deepgram
# Nova-2 first when set; Gemini (GEMINI_API_KEY) handles it otherwise.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Web search for the assistant's search tool — first configured provider
# wins: Brave -> Tavily -> built-in mock (keeps local dev fully runnable).
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Voice cloning / premium TTS (ElevenLabs). When unset the assistant
# falls back to on-device TTS in the app and Plivo TTS on calls.
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
