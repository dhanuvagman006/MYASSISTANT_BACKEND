PORT=3000

# AI provider — GEMINI ONLY. One key powers chat, streaming and voice
# transcription. Get one at aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Shared secret the Android app must send as X-App-Key
APP_API_KEY=change-me-to-a-long-random-string

# Google Sign-In (F1) — the *Web* OAuth client ID from Google Cloud Console.
# Must match GOOGLE_WEB_CLIENT_ID in the Android app's build.gradle.kts.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Dev-only fallback: allow X-App-Key auth (never set true in production)
ALLOW_APP_KEY=true   # dev mode — set false before production

# Dev mode: skip all auth. MUST be removed/false in production.
AUTH_DISABLED=true

# Session signing secret — 32+ random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Apple Sign In — your iOS bundle id (audience of Apple's identity token)
APPLE_BUNDLE_ID=com.yourorg.myassistant

# Where user document FILES live (mount a Docker volume here)
DATA_DIR=./data

# Postgres (docker-compose wires this automatically)
#DATABASE_URL=postgres://myassistant:localdev@localhost:5432/myassistant

# --- Admin stats (GET /admin/stats with X-Admin-Key) ---
# 16+ random chars; endpoint is invisible (404) while unset.
ADMIN_KEY=

# --- D-ID Face Mode + video briefings (docs.d-id.com) ---
# Studio API key ("username:password" form) — Face Mode is OFF while unset.
DID_API_KEY=
# Shared secret D-ID sends back as x-api-key when calling our custom-LLM
# endpoint (/did/llm/v1/chat/completions). 32+ random chars.
DID_LLM_KEY=
# Public HTTPS base of THIS server (the app's WebView loads /did/face from it).
PUBLIC_BASE_URL=
# OPTIONAL — custom faces / voices (unset = D-ID stock presenter):
DID_PRESENTER_SOURCE_URL=
DID_PRESENTER_ID=v2_public_Amber@0zSz8kflCN
DID_PRESENTER_ID_FEMALE=
DID_PRESENTER_ID_MALE=
DID_PRESENTER_SOURCE_URL_FEMALE=
DID_PRESENTER_SOURCE_URL_MALE=
DID_VOICE_ID=en-IN-AartiIndicNeural
DID_VOICE_ID_FEMALE=
DID_VOICE_ID_MALE=en-IN-PrabhatIndicNeural
